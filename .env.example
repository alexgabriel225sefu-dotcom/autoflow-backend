# ─── Binance ────────────────────────────────────────────────
BINANCE_API_KEY=cheia_ta_binance_api
BINANCE_API_SECRET=secretul_tau_binance

# ─── Claude AI ───────────────────────────────────────────────
ANTHROPIC_API_KEY=cheia_ta_anthropic

# ─── Marketing Agent (gratis — Groq free tier, model open-source) ──
# Cheie gratuita: https://console.groq.com/keys (fara card necesar)
GROQ_API_KEY=cheia_ta_groq
GROQ_MODEL=llama-3.3-70b-versatile
# Bot Telegram dedicat promovarii (poti reutiliza botul de afiliati)
MARKETING_TELEGRAM_BOT_TOKEN=token_bot_telegram
MARKETING_TELEGRAM_CHAT_ID=chat_id_canal_sau_grup
# La cate ore ruleaza agentul automat (default 24)
AGENT_INTERVAL_HOURS=24
# Lista de emailuri (separate prin virgula) pentru campania automata
AGENT_EMAIL_RECIPIENTS=
# Descrierea produsului folosita de agent la generarea textelor (optional,
# altfel foloseste descrierea default din agent/marketingAgent.js)
AGENT_PRODUCT_BRIEF=

# ─── Trading Config ──────────────────────────────────────────
TRADE_SYMBOL=DOGEUSDT       # simbolul de tranzacționat
TIMEFRAME=1h                 # 15m, 1h, 4h, 1d
RISK_PER_TRADE=0.02          # 2% din balanță per tranzacție
STOP_LOSS_PCT=0.02           # -2% stop loss
TAKE_PROFIT_PCT=0.04         # +4% take profit
MIN_CONFIDENCE=72            # minim 72% confidence AI pentru execuție

# ─── Mod ─────────────────────────────────────────────────────
# PAPER_TRADING=true         # fără bani reali (recomandat la început)
# BINANCE_TESTNET=true       # testnet Binance
