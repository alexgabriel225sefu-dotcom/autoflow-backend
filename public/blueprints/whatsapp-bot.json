{
  "name": "AI Cash Systems — WhatsApp Auto-Reply Bot (Module 5)",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": "YOUR_MAKE_WEBHOOK_URL",
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0, "name": "360dialog Webhook — Incoming Message" }
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "parameters": {},
      "mapper": {
        "condition": "{{1.entry[].changes[].value.messages[].type}} = text"
      },
      "metadata": {
        "designer": { "x": 300, "y": 0, "name": "Filter — Text Messages Only" }
      }
    },
    {
      "id": 3,
      "module": "openai-gpt-3:CreateChatCompletion",
      "version": 1,
      "parameters": {
        "model": "gpt-4o",
        "temperature": 0.6,
        "max_tokens": 300
      },
      "mapper": {
        "messages": [
          {
            "role": "system",
            "content": "You are a helpful WhatsApp assistant for [BUSINESS NAME]. Answer customer questions about our [PRODUCTS/SERVICES]. Be friendly, concise (under 100 words), and always in the same language as the customer message. If you cannot help, politely ask them to call [PHONE NUMBER] during business hours."
          },
          {
            "role": "user",
            "content": "{{1.entry[].changes[].value.messages[].text.body}}"
          }
        ]
      },
      "metadata": {
        "designer": { "x": 600, "y": 0, "name": "GPT-4o — Generate Reply" }
      }
    },
    {
      "id": 4,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": false },
      "mapper": {
        "url": "https://waba.360dialog.io/v1/messages",
        "method": "POST",
        "headers": [
          { "name": "D360-API-KEY", "value": "YOUR_360DIALOG_API_KEY" },
          { "name": "Content-Type", "value": "application/json" }
        ],
        "body": "{\"messaging_product\":\"whatsapp\",\"to\":\"{{1.entry[].changes[].value.messages[].from}}\",\"type\":\"text\",\"text\":{\"body\":\"{{3.choices[].message.content}}\"}}",
        "bodyType": "raw"
      },
      "metadata": {
        "designer": { "x": 900, "y": 0, "name": "360dialog — Send Reply" }
      }
    },
    {
      "id": 5,
      "module": "google-sheets:addRow",
      "version": 1,
      "parameters": {
        "spreadsheetId": "YOUR_SPREADSHEET_ID",
        "sheetId": "WhatsApp Logs"
      },
      "mapper": {
        "values": {
          "A": "{{formatDate(now; 'DD/MM/YYYY HH:mm')}}",
          "B": "{{1.entry[].changes[].value.messages[].from}}",
          "C": "{{1.entry[].changes[].value.messages[].text.body}}",
          "D": "{{3.choices[].message.content}}"
        }
      },
      "metadata": {
        "designer": { "x": 1200, "y": 0, "name": "Sheets — Log Conversation" }
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "eu2.make.com",
    "notes": "SETUP: 1) Create a CustomWebHook in Make.com and copy the URL 2) In 360dialog dashboard, set webhook URL to your Make.com webhook 3) Replace YOUR_360DIALOG_API_KEY with your 360dialog API key 4) Customize the system prompt with your client's business name and info 5) Create Google Sheet with columns: Date, Phone, Customer Message, Bot Reply"
  }
}
