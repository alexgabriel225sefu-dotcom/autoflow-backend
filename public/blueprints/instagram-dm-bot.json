{
  "name": "AI Cash Systems — Instagram DM Auto-Reply Bot (Module 6)",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": "YOUR_MAKE_WEBHOOK_URL",
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0, "name": "Instagram Webhook — Incoming DM" }
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "parameters": {},
      "mapper": {
        "condition": "{{1.object}} = instagram AND {{1.entry[].messaging[].message.text}} != null"
      },
      "metadata": {
        "designer": { "x": 300, "y": 0, "name": "Filter — DM Messages Only" }
      }
    },
    {
      "id": 3,
      "module": "openai-gpt-3:CreateChatCompletion",
      "version": 1,
      "parameters": {
        "model": "gpt-4o",
        "temperature": 0.65,
        "max_tokens": 250
      },
      "mapper": {
        "messages": [
          {
            "role": "system",
            "content": "You are the social media assistant for [BRAND NAME] on Instagram. Reply to DMs in a friendly, on-brand tone. Keep replies under 80 words. For pricing questions, say 'DM us PRICE for our full price list'. For booking, say 'Tap the link in bio to book'. Always reply in the same language as the customer."
          },
          {
            "role": "user",
            "content": "Instagram DM from @{{1.entry[].messaging[].sender.id}}:\n{{1.entry[].messaging[].message.text}}"
          }
        ]
      },
      "metadata": {
        "designer": { "x": 600, "y": 0, "name": "GPT-4o — Generate DM Reply" }
      }
    },
    {
      "id": 4,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": false },
      "mapper": {
        "url": "https://graph.facebook.com/v18.0/me/messages",
        "method": "POST",
        "headers": [
          { "name": "Content-Type", "value": "application/json" }
        ],
        "qs": [
          { "name": "access_token", "value": "YOUR_PAGE_ACCESS_TOKEN" }
        ],
        "body": "{\"recipient\":{\"id\":\"{{1.entry[].messaging[].sender.id}}\"},\"message\":{\"text\":\"{{3.choices[].message.content}}\"}}",
        "bodyType": "raw"
      },
      "metadata": {
        "designer": { "x": 900, "y": 0, "name": "Graph API — Send DM Reply" }
      }
    },
    {
      "id": 5,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true },
      "mapper": {
        "url": "https://graph.facebook.com/v18.0/{{1.entry[].id}}/mentions",
        "method": "GET",
        "qs": [
          { "name": "access_token", "value": "YOUR_PAGE_ACCESS_TOKEN" },
          { "name": "fields", "value": "id,text" }
        ]
      },
      "metadata": {
        "designer": { "x": 0, "y": 300, "name": "Graph API — Check Comment Mentions" }
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "eu2.make.com",
    "notes": "SETUP: 1) Create Facebook App at developers.facebook.com 2) Add Instagram product and get a long-lived Page Access Token 3) Set up webhook for instagram_manage_messages permission 4) Create Make.com webhook and register it in Facebook App webhook settings with verify_token 5) Replace YOUR_PAGE_ACCESS_TOKEN in both HTTP modules 6) Customize the system prompt with your client's brand voice"
  }
}
