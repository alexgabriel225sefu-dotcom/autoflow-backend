{
  "name": "AI Cash Systems — Stripe Recurring Billing Automation (Module 13)",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": "YOUR_MAKE_WEBHOOK_URL",
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0, "name": "Stripe Webhook — Event Received" }
      }
    },
    {
      "id": 2,
      "module": "builtin:RouterModule",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": { "x": 300, "y": 0, "name": "Router — Event Type" }
      },
      "routes": [
        {
          "label": "customer.subscription.created",
          "filter": "{{1.type}} = customer.subscription.created",
          "flow": [
            {
              "id": 3,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": false },
              "mapper": {
                "url": "https://api.stripe.com/v1/customers/{{1.data.object.customer}}",
                "method": "GET",
                "headers": [
                  { "name": "Authorization", "value": "Bearer YOUR_STRIPE_SECRET_KEY" }
                ]
              },
              "metadata": {
                "designer": { "x": 600, "y": -200, "name": "Stripe — Get Customer Details" }
              }
            },
            {
              "id": 4,
              "module": "gmail:ActionSendEmail",
              "version": 1,
              "parameters": {},
              "mapper": {
                "to": "{{3.email}}",
                "subject": "Welcome — your subscription is active",
                "content": "Hi {{3.name}},\n\nYour AI automation subscription is now active! Here's what happens next:\n\n✓ I'll start building your system within 24 hours\n✓ You'll receive a delivery confirmation email when it's live\n✓ Your card will be charged on the same date each month\n\nIf you have any questions, just reply to this email.\n\nExcited to work with you!\n[YOUR NAME]",
                "contentType": "text"
              },
              "metadata": {
                "designer": { "x": 900, "y": -200, "name": "Gmail — Welcome Email" }
              }
            },
            {
              "id": 5,
              "module": "google-sheets:addRow",
              "version": 1,
              "parameters": {
                "spreadsheetId": "YOUR_BILLING_SPREADSHEET_ID",
                "sheetId": "Subscriptions"
              },
              "mapper": {
                "values": {
                  "A": "{{formatDate(now; 'DD/MM/YYYY')}}",
                  "B": "{{3.name}}",
                  "C": "{{3.email}}",
                  "D": "{{divide(1.data.object.plan.amount; 100)}}",
                  "E": "Active",
                  "F": "{{1.data.object.id}}",
                  "G": "{{formatDate(multiply(1.data.object.current_period_end; 1000); 'DD/MM/YYYY')}}"
                }
              },
              "metadata": {
                "designer": { "x": 1200, "y": -200, "name": "Sheets — Log Subscription" }
              }
            }
          ]
        },
        {
          "label": "invoice.payment_failed",
          "filter": "{{1.type}} = invoice.payment_failed",
          "flow": [
            {
              "id": 6,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": false },
              "mapper": {
                "url": "https://api.stripe.com/v1/customers/{{1.data.object.customer}}",
                "method": "GET",
                "headers": [
                  { "name": "Authorization", "value": "Bearer YOUR_STRIPE_SECRET_KEY" }
                ]
              },
              "metadata": {
                "designer": { "x": 600, "y": 0, "name": "Stripe — Get Customer" }
              }
            },
            {
              "id": 7,
              "module": "gmail:ActionSendEmail",
              "version": 1,
              "parameters": {},
              "mapper": {
                "to": "{{6.email}}",
                "subject": "Action required — payment failed",
                "content": "Hi {{6.name}},\n\nWe were unable to process your payment for this month's subscription.\n\nTo keep your AI automation running, please update your payment method:\n→ [STRIPE CUSTOMER PORTAL LINK]\n\nStripe will automatically retry in 3 days. If you need help, just reply to this email.\n\n[YOUR NAME]",
                "contentType": "text"
              },
              "metadata": {
                "designer": { "x": 900, "y": 0, "name": "Gmail — Failed Payment Email" }
              }
            }
          ]
        },
        {
          "label": "customer.subscription.deleted",
          "filter": "{{1.type}} = customer.subscription.deleted",
          "flow": [
            {
              "id": 8,
              "module": "gmail:ActionSendEmail",
              "version": 1,
              "parameters": {},
              "mapper": {
                "to": "YOUR_EMAIL@example.com",
                "subject": "ALERT — Subscription cancelled: {{1.data.object.customer}}",
                "content": "A subscription was cancelled:\n\nCustomer ID: {{1.data.object.customer}}\nSubscription ID: {{1.data.object.id}}\nCancelled at: {{formatDate(multiply(1.data.object.canceled_at; 1000); 'DD/MM/YYYY HH:mm')}}\n\nFollow up with the customer within 24 hours.",
                "contentType": "text"
              },
              "metadata": {
                "designer": { "x": 600, "y": 200, "name": "Gmail — Alert You of Cancellation" }
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "eu2.make.com",
    "notes": "SETUP: 1) Create Make.com webhook and copy the URL 2) In Stripe Dashboard → Developers → Webhooks → Add endpoint, paste the URL, select events: customer.subscription.created, invoice.payment_failed, customer.subscription.deleted 3) Replace YOUR_STRIPE_SECRET_KEY in both HTTP modules (from Stripe Dashboard → Developers → API keys) 4) Create Subscriptions sheet with columns: Date, Name, Email, Amount, Status, SubscriptionID, NextBilling 5) Add Stripe Customer Portal URL in the failed payment email"
  }
}
