{
  "name": "AI Cash Systems — Lead Follow-Up System (Module 2)",
  "flow": [
    {
      "id": 1,
      "module": "google-forms:watchResponses",
      "version": 1,
      "parameters": {
        "formId": "YOUR_GOOGLE_FORM_ID"
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0, "name": "Google Form — New Lead" }
      }
    },
    {
      "id": 2,
      "module": "openai-gpt-3:CreateChatCompletion",
      "version": 1,
      "parameters": {
        "model": "gpt-4o",
        "temperature": 0.7,
        "max_tokens": 400
      },
      "mapper": {
        "messages": [
          {
            "role": "system",
            "content": "You are a professional assistant for a local business. Write a warm, personalized follow-up email in response to a new lead inquiry. Be concise (under 150 words), professional, and include a clear call to action to schedule a call. Sign off with the business name."
          },
          {
            "role": "user",
            "content": "New lead details:\nName: {{1.responses.name}}\nEmail: {{1.responses.email}}\nService interested in: {{1.responses.service}}\nMessage: {{1.responses.message}}\n\nWrite a personalized follow-up email."
          }
        ]
      },
      "metadata": {
        "designer": { "x": 300, "y": 0, "name": "GPT-4o — Generate Email" }
      }
    },
    {
      "id": 3,
      "module": "gmail:ActionSendEmail",
      "version": 1,
      "parameters": {},
      "mapper": {
        "to": "{{1.responses.email}}",
        "subject": "Re: Your inquiry — we'll get back to you shortly",
        "content": "{{2.choices[].message.content}}",
        "contentType": "text"
      },
      "metadata": {
        "designer": { "x": 600, "y": 0, "name": "Gmail — Send Follow-Up" }
      }
    },
    {
      "id": 4,
      "module": "google-sheets:addRow",
      "version": 1,
      "parameters": {
        "spreadsheetId": "YOUR_SPREADSHEET_ID",
        "sheetId": "Leads"
      },
      "mapper": {
        "values": {
          "A": "{{formatDate(now; 'DD/MM/YYYY HH:mm')}}",
          "B": "{{1.responses.name}}",
          "C": "{{1.responses.email}}",
          "D": "{{1.responses.service}}",
          "E": "{{1.responses.message}}",
          "F": "Email Sent",
          "G": "New"
        }
      },
      "metadata": {
        "designer": { "x": 900, "y": 0, "name": "Google Sheets — Log Lead" }
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "eu2.make.com",
    "notes": "SETUP: 1) Connect Google Forms account 2) Set formId to your form ID 3) Connect OpenAI account with API key 4) Connect Gmail account 5) Set spreadsheetId and create a sheet named 'Leads' with columns: Date, Name, Email, Service, Message, Status, Stage"
  }
}
