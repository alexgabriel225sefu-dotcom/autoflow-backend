{
  "name": "AI Cash Systems — Google Sheets CRM + Weekly AI Report (Module 8)",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": "YOUR_MAKE_WEBHOOK_URL",
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0, "name": "Webhook — New Lead (any source)" }
      }
    },
    {
      "id": 2,
      "module": "builtin:RouterModule",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": { "x": 300, "y": 0, "name": "Router — Identify Source" }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 3,
              "module": "google-sheets:addRow",
              "version": 1,
              "parameters": {
                "spreadsheetId": "YOUR_CRM_SPREADSHEET_ID",
                "sheetId": "CRM"
              },
              "mapper": {
                "values": {
                  "A": "{{formatDate(now; 'DD/MM/YYYY HH:mm')}}",
                  "B": "{{1.name}}",
                  "C": "{{1.email}}",
                  "D": "{{1.phone}}",
                  "E": "{{1.source}}",
                  "F": "{{1.message}}",
                  "G": "New Lead",
                  "H": "",
                  "I": "",
                  "J": "{{1.source}}"
                }
              },
              "metadata": {
                "designer": { "x": 600, "y": -150, "name": "Sheets — Add to CRM" }
              }
            }
          ],
          "label": "WhatsApp / Instagram / Form"
        }
      ]
    },
    {
      "id": 10,
      "module": "builtin:BasicTrigger",
      "version": 1,
      "parameters": {
        "type": "cron",
        "cron": "0 9 * * 1"
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 300, "name": "Trigger — Every Monday 9am" }
      }
    },
    {
      "id": 11,
      "module": "google-sheets:getRows",
      "version": 1,
      "parameters": {
        "spreadsheetId": "YOUR_CRM_SPREADSHEET_ID",
        "sheetId": "CRM",
        "limit": 100
      },
      "mapper": {
        "filter": "{{formatDate(item.Date; 'YYYY-WW')}} = {{formatDate(addDays(now; -7); 'YYYY-WW')}}"
      },
      "metadata": {
        "designer": { "x": 300, "y": 300, "name": "Sheets — Get Last 7 Days Leads" }
      }
    },
    {
      "id": 12,
      "module": "openai-gpt-3:CreateChatCompletion",
      "version": 1,
      "parameters": {
        "model": "gpt-4o",
        "temperature": 0.4,
        "max_tokens": 600
      },
      "mapper": {
        "messages": [
          {
            "role": "system",
            "content": "You are a business analyst assistant. Generate a concise weekly performance report for a local business. Format it clearly with sections: Summary, Key Metrics, Lead Sources Breakdown, Action Items. Be data-driven and practical. Write in a professional but approachable tone."
          },
          {
            "role": "user",
            "content": "Generate a weekly business report based on this CRM data from the past 7 days:\n\nTotal leads: {{count(11.rows)}}\nLead data: {{11.rows}}\n\nBusiness name: [CLIENT BUSINESS NAME]\nWeek: {{formatDate(addDays(now; -7); 'DD MMM')}} - {{formatDate(now; 'DD MMM YYYY')}}\n\nWrite the full weekly report."
          }
        ]
      },
      "metadata": {
        "designer": { "x": 600, "y": 300, "name": "GPT-4o — Write Weekly Report" }
      }
    },
    {
      "id": 13,
      "module": "gmail:ActionSendEmail",
      "version": 1,
      "parameters": {},
      "mapper": {
        "to": "CLIENT_EMAIL@example.com",
        "subject": "Weekly Business Report — {{formatDate(now; 'DD MMM YYYY')}}",
        "content": "{{12.choices[].message.content}}",
        "contentType": "text"
      },
      "metadata": {
        "designer": { "x": 900, "y": 300, "name": "Gmail — Send Report to Client" }
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "eu2.make.com",
    "notes": "CRM SHEET COLUMNS: A=Date, B=Name, C=Email, D=Phone, E=Source, F=Message, G=Status, H=Next Action, I=Value, J=Channel. SETUP: 1) Create Google Sheet with above columns 2) Set YOUR_CRM_SPREADSHEET_ID 3) Connect all your lead sources (WhatsApp webhook, Instagram webhook, Google Forms) to send data to this scenario's webhook 4) Set CLIENT_EMAIL to your client's email for weekly reports 5) The Monday 9am trigger runs separately from the webhook trigger"
  }
}
