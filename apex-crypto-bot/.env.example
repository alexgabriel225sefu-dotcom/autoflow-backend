# ─── Required ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=     # from @BotFather (ApexTradeBot_official_bot)
GROQ_API_KEY=           # free key from console.groq.com
ADMIN_CHAT_ID=          # your Telegram numeric id (owner-only commands)

# ─── Optional ───────────────────────────────────────────
ANTHROPIC_API_KEY=      # paid, optional — Groq is the free default
SITE_URL=https://aicashsystem.space

# ─── Trading defaults (clients override via Telegram) ───
TRADE_SYMBOL=BTCUSDT
TIMEFRAME=5m
PAPER_TRADING=true
PAPER_BALANCE=100
RISK_PER_TRADE=0.05
STOP_LOSS_PCT=0.016
TAKE_PROFIT_PCT=0.032
MIN_CONFIDENCE=62

# ─── Risk pause (self-healing — never latches) ──────────
MAX_CONSECUTIVE_LOSSES=3
RISK_PAUSE_MIN=60
