# Apex Crypto Bot — same engine as the forex bot, configured crypto-first.
# Trades crypto CFDs (BTCUSD, ETHUSD, SOLUSD …) through the client's own
# cTrader account: real orders on a licensed broker, 24/7 market.

# ─── Product profile ────────────────────────────────────
PRODUCT=crypto          # 24/7 market, crypto Auto-Pilot universe, CRPT-… keys

# ─── Required ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=     # from @BotFather (this bot's OWN token)
GROQ_API_KEY=           # free key from console.groq.com
ADMIN_CHAT_ID=          # your Telegram numeric id (owner-only commands)

# ─── cTrader Open API (clients connect via OAuth /ctrader) ──
CTRADER_CLIENT_ID=      # openapi.ctrader.com/apps
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=   # https://<this-service>.onrender.com/api/ctrader/callback

# ─── Optional ───────────────────────────────────────────
ANTHROPIC_API_KEY=      # paid, optional — Groq is the free default
SITE_URL=https://aicashsystem.space

# ─── Trading defaults (clients override via Telegram) ───
TRADE_SYMBOL=BTCUSD
TIMEFRAME=5m
PAPER_TRADING=true
PAPER_BALANCE=1000

# ─── Optional overrides ─────────────────────────────────
# AUTOPILOT_UNIVERSE=BTCUSD,ETHUSD,SOLUSD,XRPUSD,LTCUSD,ADAUSD,DOGEUSD,DOTUSD,LINKUSD,BCHUSD,XAUUSD
# SCAN_SYMBOLS=BTCUSD,ETHUSD,SOLUSD
