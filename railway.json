{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd apex-trade-api && npm install"
  },
  "deploy": {
    "startCommand": "cd apex-trade-api && node src/index.js",
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 25
  }
}
