# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. Real values live in .env.local and never leave the machine.
# No exceptions to this pattern, deliberately: the documented variables live
# in env.example (no leading dot), which this rule does not match. An
# exception for .env.example would create one filename under which a file
# full of real values could be committed by accident, and the whole point of
# the pattern is that no such filename exists.
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
