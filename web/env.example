# Apex4Traders — web. PLACEHOLDERS ONLY. Copy to .env.local and fill in there.
#
# Named without a leading dot on purpose, matching nova/env.example in this
# repository: the .gitignore pattern `.env*` exists so a real .env can never be
# committed by accident, and a file that documents variable NAMES should not
# have to fight it.

# Supabase Auth — the platform's identity provider.
# This is the ANON key: it is public by design and safe in a browser.
# Never put SUPABASE_SERVICE_KEY here or anywhere the client can read it —
# it bypasses Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Where the Apex4Traders backend answers. Empty means the same origin.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001
